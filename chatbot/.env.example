# Copy to .env for local testing only. Do not commit real secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
PORT=3000
# Comma-separated allowed browser origins once deployed, e.g.:
# ALLOWED_ORIGINS=https://nykon1293.github.io,http://localhost:3000
ALLOWED_ORIGINS=
RATE_LIMIT_MAX=12

# Google Sheets lead storage (already used)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_TAB=Leads

# Telegram notifications for new leads (recommended)
# Reuse the *same* bot and chat ID that your Hermes Telegram integration already uses.
# This sends lead alerts into the same conversation/thread you use with Hermes.
# 
# 1. Get the bot token + chat ID from your existing Hermes Telegram setup
#    (check .hermes/config, gateway config, or however you have Hermes connected to Telegram).
# 2. Add them in your Vercel dashboard for the portfolio-chatbot project.
#    (Never paste the actual values into this chat.)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
